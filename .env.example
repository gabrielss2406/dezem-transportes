# Credenciais do Cloudflare R2 para Backup
# Preencha estes valores para que o backup funcione automaticamente
MAIN_VITE_R2_ENDPOINT=https://<seu-account-id>.r2.cloudflarestorage.com
MAIN_VITE_R2_BUCKET=seu-nome-do-bucket
MAIN_VITE_R2_ACCESS_KEY_ID=sua-access-key-id
MAIN_VITE_R2_SECRET_ACCESS_KEY=sua-secret-access-key
