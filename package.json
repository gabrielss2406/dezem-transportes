{
  "name": "dezem-gestao-frota",
  "version": "1.0.0",
  "description": "Sistema de Gestão de Frota — Dezem Transportes",
  "main": "./out/main/index.js",
  "author": "Dezem Dev Team",
  "license": "ISC",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "type-check": "tsc --noEmit",
    "lint": "biome check --write",
    "format": "biome format --write",
    "prepare": "husky",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@hookform/resolvers": "^5.2.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "node-cron": "^4.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-imask": "^7.6.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.22.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^3.7.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jspdf": "^1.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.4"
  },
  "build": {
    "appId": "com.dezem.gestaofrota",
    "productName": "Dezem Gestão de Frota",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "useZip": false
    },
    "compression": "maximum",
    "asar": true,
    "electronLanguages": ["pt-BR", "en-US"],
    "extraResources": [
      {
        "from": ".env.production",
        "to": ".env"
      }
    ],
    "files": [
      "out/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/.bin/**",
      "!**/node_modules/*/{test,tests,__tests__,spec,specs}/**",
      "!**/node_modules/*/{doc,docs,documentation}/**",
      "!**/node_modules/*/{example,examples,demo,demos}/**",
      "!**/node_modules/*/*.{md,markdown,txt,pdf,yml,yaml}",
      "!**/node_modules/*/{README,CHANGELOG,CONTRIBUTING,LICENSE}*",
      "!**/node_modules/*/{.eslintrc,.babelrc,.editorconfig}",
      "!**/node_modules/**/*.map"
    ],
    "asarUnpack": ["**/node_modules/better-sqlite3/build/Release/*.node"]
  }
}
